# TCCS Core runtime settings for docker compose.
# Copy to .env (outside Git) and set the ARI password before starting Core.

POSTGRES_DB=tccs
POSTGRES_USER=tccs
POSTGRES_PASSWORD=change-me-local
TCCS_CORE_DB=tccs_core

TCCS_ENVIRONMENT=production
TCCS_DATABASE_URL=postgresql+asyncpg://tccs:change-me-local@postgres:5432/tccs_core
TCCS_ASTERISK_ARI_ENABLED=true
TCCS_ASTERISK_ARI_URL=http://host.docker.internal:8088/ari
TCCS_ASTERISK_ARI_USERNAME=tccs
TCCS_ASTERISK_ARI_PASSWORD=REPLACE_WITH_ARI_PASSWORD
TCCS_ASTERISK_ARI_APP=tccs-core
TCCS_ASTERISK_ARI_TIMEOUT_SECONDS=10
TCCS_ASTERISK_ARI_RECONNECT_DELAY=2
